# Database Configuration
DATABASE_URL=postgres://postgres:postgres@db:5432/photo_app

# Frontend Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI API Key (required for photo descriptions)
OPENAI_API_KEY=your_openai_api_key_here

# AI Model Paths (relative to /app directory in container)
SCRFD_MODEL_PATH=models/scrfd_2.5g_bnkps.onnx
ARCFACE_MODEL_PATH=models/arcface_r50.onnx
OSNET_MODEL_PATH=models/osnet_x0_25.onnx

# Detection Timeout (milliseconds)
DETECT_TIMEOUT_MS=8000

# Server Port
PORT=4000

# Node Environment
NODE_ENV=development
